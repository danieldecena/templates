{
  "permissions": {
    "allow": [
      "Bash({{TEST_CMD}} *)",
      "Bash({{BUILD_CMD}} *)"
    ],
    "deny": [
      "Bash(rm -rf *)"
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "npx prettier --write \"$CLAUDE_FILE_PATHS\"" }
        ]
      }
    ]
  }
}
